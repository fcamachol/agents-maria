# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Chatwoot Configuration (CEA-AWS instance)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# PostgreSQL Configuration for AGORA (Chatwoot)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=agora_production
PGPOOL_MAX=10

# CEA SOAP API Proxy (optional - for whitelisted IP access)
CEA_PROXY_URL=

# Google Gemini API (for video analysis)
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=
GEMINI_ANALYZE_MODEL=

# Google Maps API (for location resolution)
GOOGLE_MAPS_API_KEY=

# Hydra SIGE Database (AWS RDS)
HYDRA_PGHOST=
HYDRA_PGPORT=5432
HYDRA_PGUSER=usrhydra
HYDRA_PGPASSWORD=
HYDRA_PGDATABASE=hydradb

# Server Configuration
PORT=3003

# API Authentication (optional — if set, all /api/chat and /webhook requests require X-Api-Key header)
API_SECRET=

# AGORA Agent API Token (for ticket creation via REST API)
AGENT_API_TOKEN=

# CEA SOAP Credentials (defaults to WSGESTIONDEUDA if not set)
CEA_SOAP_USER=
CEA_SOAP_PASSWORD=
