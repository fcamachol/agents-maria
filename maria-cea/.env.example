# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# PostgreSQL Configuration for AGORA (Chatwoot)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=agora_production
PGPOOL_MAX=10

# CEA SOAP API Proxy (optional - for whitelisted IP access)
CEA_PROXY_URL=

# Server Configuration
PORT=3000

# Logging
LOG_LEVEL=info

# Memory (SQLite)
MEMORY_DB_PATH=./data/maria_memory.db
MEMORY_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_CONVERSATION=20
RATE_LIMIT_API=100
RATE_LIMIT_BUDGET=50

# Cache
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD=60

# Model Configuration
CLAUDE_MODEL=claude-sonnet-4-5-20250929
MAX_BUDGET_PER_MESSAGE=0.50
