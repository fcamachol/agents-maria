# ============================================
# Maria CEA Agent v2 - Environment Variables
# ============================================

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info           # fatal, error, warn, info, debug, trace

# --- Models (configurable per environment) ---
CLASSIFIER_MODEL=gpt-4.1-mini
SPECIALIST_MODEL=gpt-4.1
INFO_MODEL=gpt-4.1-mini

# --- CEA SOAP API ---
CEA_API_BASE=https://aquacis-cf-int.ceaqueretaro.gob.mx/Comercial/services
CEA_SOAP_USERNAME=WSGESTIONDEUDA
CEA_SOAP_PASSWORD=WSGESTIONDEUDA
# CEA_PROXY_URL=http://10.128.0.7:3128  # Optional: proxy for IP-whitelist

# --- PostgreSQL (AGORA/Chatwoot) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-password
PGDATABASE=agora_production
PGPOOL_MAX=10

# --- Chatwoot ---
CHATWOOT_ACCOUNT_ID=2

# --- Conversation Store ---
CONVERSATION_TTL_MS=3600000        # 1 hour
CONVERSATION_CLEANUP_MS=300000     # 5 minutes
MAX_HISTORY_MESSAGES=20

# --- Security ---
# API_KEY=your-secret-api-key      # Set to require Bearer auth
# ALLOWED_ORIGINS=https://your-domain.com,https://n8n.your-domain.com

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000         # 1 minute window
RATE_LIMIT_MAX=30                  # Max requests per window

# --- HTTP ---
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000           # Exponential backoff: 1s, 2s, 4s
REQUEST_TIMEOUT_MS=30000           # 30 second timeout
MAX_PAYLOAD_SIZE=100kb
