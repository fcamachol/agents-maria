{
  "name": "maria-cea-sdk-v2",
  "version": "2.0.0",
  "description": "Maria CEA Agent - Redesigned v2 with modular architecture, security, and observability",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx src/test.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@openai/agents": "~0.0.14",
    "dotenv": "~16.4.7",
    "express": "~4.21.2",
    "express-rate-limit": "~7.5.0",
    "fast-xml-parser": "~4.5.1",
    "pg": "~8.13.3",
    "pino": "~9.6.0",
    "pino-pretty": "~13.0.0",
    "undici": "~7.5.0",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@types/express": "~5.0.0",
    "@types/node": "~22.12.0",
    "@types/pg": "~8.11.11",
    "tsx": "~4.19.2",
    "typescript": "~5.7.3"
  }
}
