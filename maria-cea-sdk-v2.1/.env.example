# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Chatwoot/AGORA Configuration (CEA-AWS instance)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_USER_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# AGORA Agent API token — REQUIRED for ticket create/update via /agent/tickets.
# This is a server-side AGORA secret distinct from the chatwoot bot/user tokens
# above (the bot token is explicitly rejected by /agent/tickets). Request from
# the AGORA team.
AGORA_AGENT_API_TOKEN=

# PostgreSQL Configuration for AGORA (Chatwoot)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=agora_production
PGPOOL_MAX=10

# CEA SOAP API Proxy (optional - for whitelisted IP access)
CEA_PROXY_URL=

# Google Gemini API (for video analysis)
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=
GEMINI_ANALYZE_MODEL=
GEMINI_RECEIPT_MODEL=

# Google Maps API (for location resolution)
GOOGLE_MAPS_API_KEY=

# OpenAI API (for audio transcription)
OPENAI_API_KEY=

# Hydra SIGE Database (AWS RDS)
HYDRA_PGHOST=hydrabd.cluster-cuoflxxjyxja.us-east-1.rds.amazonaws.com
HYDRA_PGPORT=5432
HYDRA_PGUSER=usrhydra
HYDRA_PGPASSWORD=
HYDRA_PGDATABASE=hydradb

# Server Configuration
PORT=3003
SERVER_BASE_URL=https://info-cea.cea-info.workers.dev

# Recibo PDF Token Secret (auto-generated if not set)
RECIBO_TOKEN_SECRET=

# ============================================
# Shared session hub (cross-channel state: WhatsApp + voice)
# ============================================
# Redis backs the identity-keyed session (verified-per-channel, active-call,
# pending intent, cross-channel event inbox). If unset, an in-memory fallback is
# used (single process only — NOT shared across the text & voice servers).
REDIS_URL=redis://localhost:6379

# ============================================
# Voice channel (ElevenLabs)
# ============================================
VOICE_PORT=3004
# Optional shared secret; if set, voice webhooks require header x-elevenlabs-secret.
VOICE_WEBHOOK_SECRET=
# ElevenLabs agent id (Maria CEA voice).
ELEVENLABS_AGENT_ID=agent_7301kg0z72effkvtqghs2hx58bpt
# ElevenLabs post-call webhook HMAC secret (verifies the ElevenLabs-Signature header
# on POST /el/post-call). Get it from the ElevenLabs workspace webhook settings.
ELEVENLABS_CONVAI_WEBHOOK_SECRET=
# WhatsApp number Maria points callers to for sending photos.
WHATSAPP_NUMBER=442-238-8200
