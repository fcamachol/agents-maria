# María - Claude Code Edition
FROM node:20-slim

WORKDIR /app

# Install dependencies
COPY package-claude.json ./package.json
COPY package-lock.json* ./
RUN npm install

# Copy source
COPY tsconfig.json ./
COPY src/ ./src/

# Build
RUN npm run build

# Environment
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "dist/server-claude.js"]
