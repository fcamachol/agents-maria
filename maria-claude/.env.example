# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# PostgreSQL Configuration for AGORA (Chatwoot)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=agora_production
PGPOOL_MAX=10

# CEA SOAP API Proxy (optional - for whitelisted IP access)
CEA_PROXY_URL=

# Google Gemini API (for video analysis)
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL= # Optional: cheap model for classification (default: gemini-2.5-flash-lite)
GEMINI_ANALYZE_MODEL=  # Optional: smart model for analysis (default: gemini-2.5-flash)

# Google Maps API (for location resolution - Places Text Search + Geocoding)
GOOGLE_MAPS_API_KEY=

# Server Configuration
PORT=3000
