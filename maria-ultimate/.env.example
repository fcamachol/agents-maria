# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Chatwoot Configuration
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_USER_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# PostgreSQL Configuration for AGORA (Chatwoot)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=agora_production
PGPOOL_MAX=10

# CEA SOAP API Proxy (optional - for whitelisted IP access)
CEA_PROXY_URL=

# Google Gemini API (for video analysis)
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=
GEMINI_ANALYZE_MODEL=

# Google Maps API (for location resolution)
GOOGLE_MAPS_API_KEY=

# OpenAI API (for audio transcription)
OPENAI_API_KEY=

# Admin API Key (for hot-reload endpoint)
ADMIN_API_KEY=

# Recibo PDF token secret
RECIBO_TOKEN_SECRET=

# Server Configuration
PORT=3000
SERVER_BASE_URL=
